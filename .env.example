# File Transfer App Configuration
# Server Settings
HOST=0.0.0.0
PORT=5000
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Production Public URL (leave empty for local LAN usage)
# Example for Render:  https://relay.onrender.com
# Example for Railway: https://relay.up.railway.app
PUBLIC_BASE_URL=

# Session & Transfer Settings
SESSION_TIMEOUT_MINUTES=5
MAX_CONTENT_LENGTH_MB=250

# Security Settings
ENABLE_SESSION_PIN=false

# Optional Browser Auto-launch (true / false, local development only)
OPEN_BROWSER=false

# Optional External API keys (if used in future integrations)
ANTHROPIC_AUTH_TOKEN=YOUR_ANTHROPIC_AUTH_TOKEN_HERE
ANTHROPIC_BASE_URL=https://openrouter.ai/api
